[bastion]
# replace BASTION_IP with your actual jump‐host IP
bastion ansible_host=10.0.1.11
        ansible_user=ec2-user
        ansible_ssh_private_key_file=/home/ec2-user/.ssh/bastion-key

[appservers]
10.0.1.238
10.0.1.240

[appservers:vars]
# these vars apply to both appservers
ansible_user=ec2-user
# proxy all SSH through the bastion host defined above
ansible_ssh_common_args='-o ProxyJump=ec2-user@bastion'
