[bastion]
10.0.1.11 ansible_user=ec2-user ansible_ssh_private_key_file=/home/ec2-user/.ssh/bastion-key

[appservers]
10.0.1.238 ansible_user=ec2-user
10.0.1.240 ansible_user=ec2-user

[appservers:vars]
# Tunnel all SSH through the bastion using the bastion-key:
ansible_ssh_common_args='-o ProxyCommand="ssh -i /home/ec2-user/.ssh/bastion-key -W %h:%p ec2-user@10.0.1.11"'
